{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/store/(.*)", "destination": "/index.html" },
    { "source": "/store", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/blog/(.*)", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/nfc/(.*)", "destination": "/index.html" },
    { "source": "/u/(.*)", "destination": "/index.html" }
  ],
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
