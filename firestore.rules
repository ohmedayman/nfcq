rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal access for Lamsa NFC profiles, orders, admins, and products
    // to ensure 100% sync across all browsers and devices
    match /profiles/{uid} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /admins/{uid} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }
  }
}
